generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  ACTIVE
  STALE
  EXPIRED
  SUSPICIOUS
  UNKNOWN
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
  UNKNOWN
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
  DISABLED
}

enum EmailDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

model User {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  normalizedEmail     String      @unique
  passwordHash        String
  locale              String      @default("en")
  timezone            String      @default("UTC")
  role                Role        @default(USER)
  status              UserStatus  @default(PENDING_VERIFICATION)
  emailVerifiedAt     DateTime?
  failedLoginAttempts Int         @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  savedItems   SavedItem[]
  applications Application[]
  alerts       Alert[]
  sessions     Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  auditEvents AuthAuditEvent[] @relation("AuthAuditActor")
  targetedAuditEvents AuthAuditEvent[] @relation("AuthAuditTarget")
  emailDeliveries EmailDelivery[]

  @@index([role, status])
  @@index([normalizedEmail])
}

model Session {
  id                  String    @id @default(cuid())
  userId              String
  accessTokenHash     String    @unique
  refreshTokenHash    String    @unique
  tokenFamilyId       String
  expiresAt           DateTime
  accessExpiresAt     DateTime
  revokedAt           DateTime?
  revokedReason       String?
  replacedBySessionId String?
  lastUsedAt          DateTime  @default(now())
  createdAt           DateTime  @default(now())
  ipAddress           String?
  userAgent           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacement Session? @relation("SessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replacedSessions Session[] @relation("SessionReplacement")

  @@index([userId, expiresAt])
  @@index([tokenFamilyId])
  @@index([revokedAt])
}

model EmailVerificationToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model AuthAuditEvent {
  id            String   @id @default(cuid())
  actorUserId   String?
  eventType     String
  targetUserId  String?
  success       Boolean
  metadata      Json?
  createdAt     DateTime @default(now())

  actor User? @relation("AuthAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target User? @relation("AuthAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
}

model EmailDelivery {
  id            String              @id @default(cuid())
  userId        String?
  toEmail       String
  template      String
  subject       String
  provider      String
  dedupeKey     String              @unique
  status        EmailDeliveryStatus @default(QUEUED)
  providerMessageId String?
  failureCode   String?
  failureType   String?
  attempts      Int                 @default(0)
  lastAttemptAt DateTime?
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([providerMessageId])
}

model Company {
  id                String   @id @default(cuid())
  slug              String   @unique
  canonicalName     String
  domain            String?
  logoUrl           String?
  verificationState String   @default("unknown")
  aliases           String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  jobs            Job[]
  providerRecords ProviderRecord[]

  @@index([canonicalName])
}

model Job {
  id                String    @id @default(cuid())
  slug              String    @unique
  canonicalTitle    String
  normalizedRole    String?
  seniority         String?
  employmentType    String?
  descriptionText   String?
  descriptionHtml   String?
  workMode          WorkMode  @default(UNKNOWN)
  remoteScope       String?
  remoteRestrictions Json?
  remoteCountryCodes String[] @default([])
  remoteRestrictionLabels String[] @default([])
  remoteTimezoneRestrictions String[] @default([])
  requiredSkills    String[]  @default([])
  preferredSkills   String[]  @default([])
  authorization     Json?
  contentHash       String?
  status            JobStatus @default(UNKNOWN)
  moderationState   String    @default("pending")
  sourceDisclosure  Json?
  canonicalFingerprint String?
  searchDocument    String?
  publishedAt       DateTime?
  sourcePublishedAt DateTime?
  sourceUpdatedAt   DateTime?
  discoveredAt      DateTime  @default(now())
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  verifiedAt        DateTime?
  updatedAt         DateTime  @updatedAt
  expiresAt         DateTime?
  providerExpiresAt DateTime?
  applicationDeadlineAt DateTime?
  deadlineMetadata  Json?
  expiredAt         DateTime?
  companyId         String?
  sourceId          String?
  primaryOccurrenceId String?  @unique

  company     Company?        @relation(fields: [companyId], references: [id])
  source      Source?         @relation(fields: [sourceId], references: [id])
  occurrences JobOccurrence[]
  providerRecords ProviderRecord[]
  locations   JobLocation[]
  salaries    Salary[]
  savedItems  SavedItem[]
  applications Application[]

  @@index([status, publishedAt, discoveredAt, id])
  @@index([status, updatedAt, id])
  @@index([status, applicationDeadlineAt, publishedAt, id])
  @@index([status, workMode])
  @@index([status, remoteScope])
  @@index([status, seniority])
  @@index([status, employmentType])
  @@index([companyId])
  @@index([sourceId])
  @@index([canonicalFingerprint])
}

model Location {
  id        String   @id @default(cuid())
  alpha2    String?
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs JobLocation[]

  @@index([name])
}

model JobLocation {
  jobId      String
  locationId String

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([jobId, locationId])
}

model Source {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  baseUrl           String
  attributionPolicy String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  jobs            Job[]
  providerRecords ProviderRecord[]
}

model ProviderRecord {
  id                String   @id @default(cuid())
  providerId        String
  externalId        String
  recordType        String
  sourceId          String
  jobId             String?
  companyId         String?
  sourceUrl         String
  applicationUrl    String?
  rawPayload        Json
  schemaVersion     String
  contentHash       String
  providerPublishedAt DateTime?
  providerUpdatedAt   DateTime?
  fetchedAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  observedState     String   @default("active")

  source  Source   @relation(fields: [sourceId], references: [id])
  job     Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@unique([providerId, externalId, recordType])
  @@index([jobId])
  @@index([companyId])
  @@index([providerId, fetchedAt])
}

model JobOccurrence {
  id               String   @id @default(cuid())
  providerId       String
  externalId       String
  sourceName       String
  sourceUrl        String
  applicationUrl   String?
  rawPayload       Json?
  schemaVersion    String
  attributionPolicy String?
  retentionPolicy  String?
  providerPublishedAt DateTime?
  providerUpdatedAt   DateTime?
  fetchedAt        DateTime @default(now())
  observedState    String   @default("unknown")
  contentHash      String?
  jobId            String

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalId])
  @@index([jobId])
  @@index([providerId, fetchedAt])
}

model Salary {
  id        String  @id @default(cuid())
  jobId     String
  currency  String?
  min       Int?
  max       Int?
  period    String?
  source    String?
  ambiguity String  @default("unknown")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([currency, min, max])
}

model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  itemType  String
  itemId    String
  jobId     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, itemType, itemId])
}

model Application {
  id         String   @id @default(cuid())
  userId     String
  jobId      String?
  roleTitle  String
  companyName String?
  stage      String   @default("saved")
  nextAction String?
  notes      String?
  appliedAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job? @relation(fields: [jobId], references: [id])
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  name      String
  filters   Json
  cadence   String   @default("daily")
  channels  String[] @default([])
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries AlertDelivery[]
}

model AlertDelivery {
  id        String   @id @default(cuid())
  alertId   String
  itemType  String
  itemId    String
  dedupeKey String   @unique
  status    String
  sentAt    DateTime?
  createdAt DateTime @default(now())

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
}

model IngestionRun {
  id          String   @id @default(cuid())
  providerId  String
  partition   String
  mode        String   @default("incremental")
  status      String
  startingCheckpoint String?
  pagesFetched Int @default(0)
  pagesRequested Int @default(0)
  pagesCompleted Int @default(0)
  recordsFetched  Int @default(0)
  recordsAccepted Int @default(0)
  recordsRejected Int @default(0)
  recordsCreated  Int @default(0)
  recordsUpdated  Int @default(0)
  recordsUnchanged Int @default(0)
  recordsExpired Int @default(0)
  retryCount Int @default(0)
  terminalCursor String?
  terminalCheckpoint String?
  stopReason String?
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  metadata    Json?

  @@index([providerId, startedAt])
}

model IngestionCheckpoint {
  providerId String
  mode       String
  cursor     String?
  watermarkExternalId String?
  watermarkContentHash String?
  updatedAt  DateTime @updatedAt
  metadata   Json?

  @@id([providerId, mode])
  @@index([providerId, updatedAt])
}

model FreshnessEvent {
  id        String   @id @default(cuid())
  targetType String
  targetId   String
  eventType  String
  evidence   Json?
  occurredAt DateTime @default(now())

  @@index([targetType, targetId, occurredAt])
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  actorType String
  action    String
  targetType String
  targetId   String?
  requestId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorType, createdAt])
  @@index([targetType, targetId])
}
