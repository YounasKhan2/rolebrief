NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
PUBLIC_APP_URL=http://localhost:8443
DATABASE_URL=postgresql://rolebrief:rolebrief_dev_password@localhost:5432/rolebrief?schema=public
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=rb:v1
WORKER_CONCURRENCY=5
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=rolebrief-web
SESSION_SECRET=replace-with-a-32-character-dev-secret
HIMALAYAS_ENABLED=false
HIMALAYAS_API_URL=https://himalayas.app/jobs/api
HIMALAYAS_TIMEOUT_MS=5000
HIMALAYAS_PAGE_LIMIT=20
HIMALAYAS_MAX_PAGES_PER_RUN=5
HIMALAYAS_RETRY_ATTEMPTS=2
HIMALAYAS_RETRY_DELAY_MS=500
HIMALAYAS_RATE_LIMIT_DELAY_MS=1000
HIMALAYAS_CRON=0 3 * * *
HIMALAYAS_LIVE_SMOKE=false
APITUBE_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
