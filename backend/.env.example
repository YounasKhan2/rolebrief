NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
PUBLIC_APP_URL=http://localhost:8443
FRONTEND_ORIGIN=http://localhost:8443,http://127.0.0.1:8443,http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=postgresql://rolebrief:<local-database-password>@localhost:5432/rolebrief?schema=public
DATABASE_POOL_SIZE=10
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=rb:v1
WORKER_CONCURRENCY=5
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=rolebrief-web
SESSION_SECRET=replace-with-a-32-character-dev-secret
ACCESS_TOKEN_TTL=900
REFRESH_SESSION_TTL=2592000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT_LOGIN=10
AUTH_RATE_LIMIT_SIGNUP=5
AUTH_RATE_LIMIT_RECOVERY=5
AUTH_RATE_LIMIT_REFRESH=60
EMAIL_PROVIDER=dev
EMAIL_DELIVERY_ENABLED=true
EMAIL_EXPOSE_DEV_LINKS=false
EMAIL_FROM=RoleBrief <onboarding@resend.dev>
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
SMTP_URL=
RESEND_API_KEY=
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
HIMALAYAS_ENABLED=false
HIMALAYAS_API_URL=https://himalayas.app/jobs/api
HIMALAYAS_PAGE_LIMIT=20
HIMALAYAS_REQUEST_TIMEOUT_MS=15000
HIMALAYAS_INITIAL_BACKFILL_MAX_PAGES=25
HIMALAYAS_SYNC_MAX_PAGES=10
HIMALAYAS_REQUEST_DELAY_MS=3000
HIMALAYAS_UNCHANGED_STOP_THRESHOLD=20
HIMALAYAS_MAX_RETRIES=3
HIMALAYAS_RETRY_DELAY_MS=500
HIMALAYAS_RATE_LIMIT_DELAY_MS=1000
HIMALAYAS_CRON=0 3 * * *
HIMALAYAS_LIVE_SMOKE=false
HIMALAYAS_LIVE_SMOKE_PERSIST=false

# Resume upload foundation: S3-compatible storage. Local Docker uses RustFS.
RESUME_STORAGE_ENDPOINT=http://localhost:9000
RESUME_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
RESUME_STORAGE_REGION=us-east-1
RESUME_STORAGE_BUCKET=rolebrief-resumes
RESUME_STORAGE_ACCESS_KEY_ID=rolebrief
RESUME_STORAGE_SECRET_ACCESS_KEY=rolebrief-local-secret
RESUME_STORAGE_FORCE_PATH_STYLE=true
RESUME_UPLOAD_MAX_BYTES=10485760
RESUME_UPLOAD_URL_TTL_SECONDS=300
RESUME_RATE_LIMIT_UPLOAD_SESSION=8
RESUME_RATE_LIMIT_CONFIRM_UPLOAD=12
RESUME_PROCESSING_MAX_ATTEMPTS=3
RESUME_PROCESSING_LEASE_SECONDS=120
RESUME_PROCESSING_TIMEOUT_MS=20000
RESUME_PDF_MAX_PAGES=20
RESUME_DOCX_MAX_ENTRIES=300
RESUME_DOCX_MAX_UNCOMPRESSED_BYTES=20971520
RESUME_DOCX_MAX_ENTRY_BYTES=5242880
RESUME_DOCX_MAX_COMPRESSION_RATIO=100
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_MS=15000
APITUBE_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
DOCLING_SERVICE_URL=http://localhost:8080
DOCLING_INTERNAL_TOKEN=replace-with-docling-internal-token
DOCLING_REQUEST_TIMEOUT_MS=30000
DOCLING_RESPONSE_MAX_BYTES=5242880
RESUME_EXTRACTION_MAX_BLOCKS=1500
RESUME_EXTRACTION_MAX_TEXT_BYTES=2097152
RESUME_EXTRACTION_MAX_BLOCK_TEXT_BYTES=8000
RESUME_EXTRACTION_OCR_MIN_BLOCKS=3
RESUME_EXTRACTION_MAX_RECONCILE=25
